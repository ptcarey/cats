{
  "name": "cat-soccer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cat Soccer - a 3v3 soccer game with customisable cats, built for kids aged 5-10.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "icons": "node scripts/gen-icons.mjs",
    "deploy": "npm run build && wrangler deploy",
    "sim": "esbuild scripts/sim.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim.mjs --log-level=warning && node node_modules/.cache/sim.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "wrangler": "^4.135.0"
  }
}
